<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Outer Time Dial ring -->
    <path
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M54,28 A26,26 0 1,1 42,30.9">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="0.5" android:color="#6366F1" />
                <item android:offset="1.0" android:color="#A855F7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hour and minute hands flowing into an arrow -->
    <path
        android:strokeWidth="4"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,38 L54,54 L66,54" />

    <!-- Central core point -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M54,54 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0" />

    <!-- Dynamic Flow tick marks -->
    <path
        android:strokeWidth="2.5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round"
        android:pathData="M54,22 L54,25" />
    <path
        android:strokeWidth="2.5"
        android:strokeColor="#818CF8"
        android:strokeLineCap="round"
        android:pathData="M86,54 L83,54" />
    <path
        android:strokeWidth="2.5"
        android:strokeColor="#A855F7"
        android:strokeLineCap="round"
        android:pathData="M54,86 L54,83" />
    <path
        android:strokeWidth="2.5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round"
        android:pathData="M22,54 L25,54" />

    <!-- Forward momentum flow wave -->
    <path
        android:strokeWidth="2"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round"
        android:pathData="M66,66 C70,70 76,72 80,68" />
</vector>
